# App origin (Better Auth baseURL / trustedOrigins). Under `wrangler dev` this is the
# local worker URL, e.g. http://localhost:8787.
ORIGIN=""

# Better Auth
# For production use 32 characters generated with high entropy.
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# GitHub OAuth — https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Comma/space-separated GitHub logins granted admin (+ host) on sign-in.
ADMIN_GITHUB_USERNAMES=""

# Dev-only auth bypass (local .dev.vars only; never set in a deployed environment).
# See docs/adr/0003-dev-only-auth-bypass-for-autonomous-verification.md.
DEV_AUTH=""
