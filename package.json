{
	"name": "pole",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"auth:schema": "better-auth generate --config ./src/lib/server/auth.ts --output ./src/lib/server/db/auth-schema.ts",
		"cf:types": "wrangler types && node scripts/fix-worker-types.mjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply control --local",
		"db:reset": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply control --local",
		"cf:dev": "vite build && wrangler dev --port 8787"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.22",
		"@cloudflare/workers-types": "^4.20260702.1",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^25.9.9",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"wrangler": "^4.153.0"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.6.11",
		"@sentry/cloudflare": "^10.76.2",
		"@sentry/sveltekit": "^10.76.2",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"better-auth": "1.6.11",
		"better-call": "2.0.6",
		"drizzle-orm": "^0.45.4",
		"jose": "^6.2.13"
	},
	"packageManager": "pnpm@10.33.2"
}
